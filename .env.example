# Discovery booking (src/app/discovery/actions.ts). All optional locally:
# without RESEND_API_KEY / BOOKING_FROM the form shows its email fallback and keeps what was typed.
RESEND_API_KEY=
# A sender address on a domain verified in Resend, e.g. "Camino Code <booking@caminocode.com>"
BOOKING_FROM=
# Where booking requests are delivered (defaults to contact@caminocode.com)
BOOKING_TO=contact@caminocode.com
# Random string used to sign the form's timestamp. Set it in production;
# without it a fixed development secret is used and a warning is logged once.
FORM_SECRET=
