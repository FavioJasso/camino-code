# Discovery booking (src/app/discovery/actions.ts).
# Locally all of these are optional: without RESEND_API_KEY / BOOKING_FROM the form shows its
# email fallback and keeps what was typed.
# In production (and on any preview where bookings must actually send), RESEND_API_KEY,
# BOOKING_FROM and FORM_SECRET are all required. Vercel applies new variables only to new
# deployments, so redeploy after adding them.
RESEND_API_KEY=
# Required wherever bookings must send: a sender address on a domain verified in Resend,
# e.g. "Camino Code <booking@caminocode.com>". Without it every booking shows the email fallback.
BOOKING_FROM=
# Where booking requests are delivered (defaults to contact@caminocode.com)
BOOKING_TO=contact@caminocode.com
# Random string used to sign the form's timestamp. Required in production (and on any preview
# that has RESEND_API_KEY): without it every booking shows the email fallback.
# Locally a development secret is used and a warning is logged once.
FORM_SECRET=
